{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "dev": "npm run prepare  && nodemon --watch src --exec \"node --loader ts-node/esm src/index.ts\"",
    "prepare": "husky",
    "format": "prettier --write .",
    "build": "tsc",
    "start:static": "node dist/index.js",
    "debug": "node --inspect-brk=9229 --loader ts-node/esm src/index.ts",
    "db:start": "docker compose --project-directory \"../docker-compose.yml\" up -d",
    "db:stop": "docker compose --project-directory \"../docker-compose.yml\" down",
    "db:rm": "docker compose --project-directory \"../docker-compose.yml\" rm -v",
    "db:status": "docker compose --project-directory \"../docker-compose.yml\" ps",
    "db:restart": "docker compose --project-directory \"../docker-compose.yml\" restart",
    "db:seed": "node --loader ts-node/esm src/seed.ts",
    "open:mongo": "start http://localhost:8081",
    "open:redis": "start http://localhost:8082"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-slow-down": "^1.3.5",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^24.9.0",
    "@types/nodemailer": "^6.4.20",
    "@types/qrcode": "^1.5.5",
    "@types/redis": "^4.0.10",
    "@types/validator": "^13.15.3",
    "@types/winston": "^2.4.4",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "nodemailer": "^7.0.9",
    "qrcode": "^1.5.4",
    "redis": "^5.8.3",
    "speakeasy": "^2.0.0",
    "validator": "^13.15.15",
    "winston": "^3.18.3",
    "xss-clean": "^0.1.4"
  }
