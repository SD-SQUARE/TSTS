
commitMsg=$(cat "$1")
echo "🔍 Commit message: $commitMsg"

# Check if it starts with 'test:'
if echo "$commitMsg" | grep -q '^test:'; then
	tag=$(echo "$commitMsg" | cut -d ':' -f2 | xargs)
	echo "🧪 Running only test with name: $tag"

	node --experimental-vm-modules node_modules/jest/bin/jest.js "$tag.test.js" || exit 1
else
	echo "✅ Skipping tests for non-test commit"
fi

npx commitlint --edit "$1"